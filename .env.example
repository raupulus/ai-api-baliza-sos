# ===========================================================================
# CONFIGURACIÓN DEL ASISTENTE DE EMERGENCIAS (DOCKER / PRODUCCIÓN / DEV)
# ===========================================================================
# Copia este archivo a .env y ajusta los valores antes de iniciar con Docker:
#     cp .env.example .env
#
# IMPORTANTE: .env NUNCA se sube a git (está protegido en .gitignore).
# ===========================================================================

# --- 1. ALMACENAMIENTO PERSISTENTE EN EL HOST ---
# En Raspberry Pi (producción): /var/ia/bot-emergencias
# En desarrollo local (Mac/PC): ./data
HOST_STORAGE_PATH=/var/ia/bot-emergencias

# --- 2. SERVICIO API DEL BOT & WEB ---
API_HOST=0.0.0.0
API_PORT=8870
WEB_PORT=8443
# Token Bearer para autorizar clientes (Meshtastic / Telegram)
API_AUTH_TOKEN=CAMBIA_ESTE_TOKEN_SEGURO
# Máximo de inferencias simultáneas (1 para proteger RAM en RPi)
API_MAX_CONCURRENT_INFERENCES=1
# Permitir arranque con token por defecto (solo true en dev local rápido)
API_ALLOW_INSECURE_TOKEN=false

# --- 3. INFERENCIA LLM (llama.cpp) ---
# Puerto del servidor llama.cpp
LLM_SERVER_HOST=llm
LLM_SERVER_PORT=8869
# Nombre del archivo del modelo en el directorio de modelos ($HOST_STORAGE_PATH/models/)
LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
LLM_MODEL_PATH=/models/qwen2.5-3b-instruct-q4_k_m.gguf
# Hilos de CPU: 3 en RPi5 (deja 1 núcleo 100% libre para Hailo-8 / vídeo)
LLM_THREADS=3
LLM_CONTEXT_SIZE=2048
LLM_MAX_TOKENS=320
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=280

# --- 4. BASE DE DATOS VECTORIAL (pgvector / PostgreSQL 17) ---
# Nombre de host interno en la red Docker (servicio 'db')
DB_HOST=db
DB_PORT=5432
# Puerto mapeado en el host si deseas conectar herramientas externas (5433 evita conflicto con PG17 del host)
HOST_DB_PORT=5433
DB_NAME=bot_emergencias
DB_USER=bot
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_POSTGRES

# --- 5. EMBEDDINGS & RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
RAG_TOP_K=4
RAG_MIN_SCORE=0.42
RAG_MAX_CONTEXT_CHARS=1800

# --- 6. CONTEXTO GEOGRÁFICO ---
PROVINCIA=Cádiz
PROVINCIA_SLUG=cadiz
PAIS=España
PAIS_CODIGO_ISO=ES
BBOX=-6.50,35.95,-5.10,37.05
PROVINCIA_CODIGO_INE=11
IDIOMA=es

# --- 7. FORMATO DE MENSAJES (Meshtastic / LoRa) ---
RESP_MAX_BYTES_PER_MSG=200
RESP_MAX_CHARS_PER_MSG=200
RESP_MAX_MESSAGES=3
RESP_DISCLAIMER_MEDICO=Info orientativa. Llama al 112.

# --- 8. ACTUALIZADOR DE CONTEXTO ---
UPDATER_STAGING_DIR=/app/data/staging
UPDATER_USER_AGENT=bot-ia-auxiliar/0.1 (+contacto: raupulus@gmail.com)
AEMET_API_KEY=

# --- 9. MEMORIA CONVERSACIONAL Y MULTI-TURNO ---
CONV_MAX_TURNOS=20
CONV_TURNOS_COMPACTAR=10
CONV_TTL_SEGUNDOS=3600

# --- 10. LOGGING ---
LOG_LEVEL=INFO
LOG_DIR=/app/logs
